<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio - Graphic Designer</title>
    <link rel="stylesheet" href="style.css">
    <!-- Google Fonts & Font Awesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Prompt:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- Container หลักสไตล์การ์ดตัดเฉียง -->
    <div class="portfolio-card">
        <!-- Header Navigation -->
        <header class="navbar">
            <div class="logo">Graphic Designer</div>
            <nav class="nav-links">
                <a href="#home" class="active">Home</a>
                <a href="#about">About</a>
                <a href="#portfolio">Works</a>
                <a href="#contact">Contact</a>
            </nav>
        </header>

        <!-- ================= PAGE 1: หน้าแรก (HOME) ================= -->
        <section id="home" class="page-section active">
            <div class="hero-content">
                <div class="hero-text">
                    <span class="greeting">Hi i'm</span>
                    <h1>Graphic<br><span>Designer</span></h1>
                    <a href="#about" class="btn-more">View More</a>
                </div>
                <div class="hero-image-container">
                    <!-- เปลี่ยนเป็นรูปของคุณ -->
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=600&auto=format&fit=crop" alt="Profile Image" class="profile-img">
                </div>
            </div>
        </section>

        <!-- ================= PAGE 2: คำนำ & ประวัติ (ABOUT) ================= -->
        <section id="about" class="page-section">
            <div class="inner-content">
                <h2 class="section-title">คำนำ & <span>ประวัติส่วนตัว</span></h2>
                <div class="about-grid">
                    <div class="about-text">
                        <h3>ยินดีต้อนรับสู่พอร์ตโฟลิโอของฉัน</h3>
                        <p>แฟ้มสะสมผลงานฉบับนี้จัดทำขึ้นเพื่อนำเสนอประวัติ ความรู้ ความสามารถ และผลงานการออกแบบกราฟิกตลอดช่วงเวลาที่ผ่านมา หวังว่าพอร์ตโฟลิโอนี้จะทำให้ท่านได้เห็นถึงศักยภาพและความตั้งใจในการทำงานของฉันครับ/ค่ะ</p>
                        
                        <div class="bio-details">
                            <p><strong>ชื่อ-นามสกุล:</strong> นายณัฐพงษ์ ใจดี (Vijai)</p>
                            <p><strong>การศึกษา:</strong> ปริญญาตรี สาขาเทคโนโลยีมัลติมีเดียและการออกแบบ</p>
                            <p><strong>ความสามารถพิเศษ:</strong> Graphic Design, Brand Identity, UI/UX Design, Photo Editing</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= PAGE 3: ผลงาน (PORTFOLIO / WORKS) ================= -->
        <section id="portfolio" class="page-section">
            <div class="inner-content">
                <h2 class="section-title">ผลงาน <span>(Portfolio)</span></h2>
                <div class="portfolio-grid">
                    <div class="portfolio-item">
                        <img src="https://images.unsplash.com/photo-1626785774573-4b799315345d?q=80&w=500&auto=format&fit=crop" alt="Work 1">
                        <div class="portfolio-overlay">
                            <h4>Branding & Logo</h4>
                        </div>
                    </div>
                    <div class="portfolio-item">
                        <img src="https://images.unsplash.com/photo-1542744094-3a31b272c490?q=80&w=500&auto=format&fit=crop" alt="Work 2">
                        <div class="portfolio-overlay">
                            <h4>Poster Design</h4>
                        </div>
                    </div>
                    <div class="portfolio-item">
                        <img src="https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?q=80&w=500&auto=format&fit=crop" alt="Work 3">
                        <div class="portfolio-overlay">
                            <h4>Social Media Ad</h4>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= PAGE 4: ติดต่อ (CONTACT) ================= -->
        <section id="contact" class="page-section">
            <div class="inner-content">
                <h2 class="section-title">ช่องทางการ <span>ติดต่อ</span></h2>
                <div class="contact-container">
                    <div class="contact-info">
                        <div class="info-item">
                            <i class="fa-solid fa-envelope"></i>
                            <div>
                                <h4>Email</h4>
                                <p>contact@yourdomain.com</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fa-solid fa-phone"></i>
                            <div>
                                <h4>Phone</h4>
                                <p>+66 81 234 5678</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fa-solid fa-location-dot"></i>
                            <div>
                                <h4>Location</h4>
                                <p>Bangkok, Thailand</p>
                            </div>
                        </div>
                    </div>

                    <form class="contact-form" onsubmit="event.preventDefault(); alert('ส่งข้อความเรียบร้อยแล้ว!');">
                        <input type="text" placeholder="ชื่อของคุณ" required>
                        <input type="email" placeholder="อีเมลของคุณ" required>
                        <textarea rows="4" placeholder="ข้อความที่ต้องการส่ง..." required></textarea>
                        <button type="submit" class="btn-more">ส่งข้อความ</button>
                    </form>
                </div>
            </div>
        </section>
    </div>

    <!-- Social Link มุมซ้ายล่าง -->
    <div class="social-footer">
        <a href="https://instagram.com" target="_blank"><i class="fa-brands fa-instagram"></i> vijaiiii</a>
    </div>

    <!-- Script สลับหน้าเมนู -->
    <script>
        const navLinks = document.querySelectorAll('.nav-links a');
        const sections = document.querySelectorAll('.page-section');

        navLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href').substring(1);

                // เปลี่ยนคลาส active ให้เมนู
                navLinks.forEach(item => item.classList.remove('active'));
                this.classList.add('active');

                // เปลี่ยนหน้า Section
                sections.forEach(section => {
                    if (section.id === targetId) {
                        section.classList.add('active');
                    } else {
                        section.classList.remove('active');
                    }
                });
            });
        });
    </script>
</body>
</html>
