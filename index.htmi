<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, "Tahoma", sans-serif;
            background: #1f1f1f;
            color: #eeeeee;
            line-height: 1.7;
        }

        /* ---------- Navigation ---------- */

        nav {
            width: 100%;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;

            background: #181818;
            border-bottom: 1px solid #b89b5e;

            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            color: #d4af65;
            font-size: 24px;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav a {
            color: #eeeeee;
            text-decoration: none;
            transition: 0.3s;
        }

        nav a:hover {
            color: #d4af65;
        }

        /* ---------- Hero ---------- */

        .hero {
            min-height: 90vh;
            padding: 80px 8%;

            display: flex;
            justify-content: center;
            align-items: center;
            gap: 80px;

            background:
                linear-gradient(
                    135deg,
                    #1b1b1b,
                    #303030
                );
        }

        .profile-image {
            width: 280px;
            height: 280px;

            object-fit: cover;

            border-radius: 50%;

            border: 5px solid #d4af65;

            box-shadow:
                0 0 30px rgba(212, 175, 101, 0.25);
        }

        .hero-text {
            max-width: 600px;
        }

        .hero-text .hello {
            color: #d4af65;
            font-size: 20px;
        }

        .hero-text h1 {
            font-size: 55px;
            margin: 10px 0;
            color: white;
        }

        .hero-text h1 span {
            color: #d4af65;
        }

        .hero-text p {
            color: #cccccc;
            font-size: 18px;
        }

        /* ---------- Buttons ---------- */

        .buttons {
            margin-top: 30px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;

            padding: 12px 25px;

            border-radius: 8px;

            text-decoration: none;
            font-weight: bold;

            transition: 0.3s;
        }

        .btn-gold {
            background: #d4af65;
            color: #1b1b1b;
        }

        .btn-gold:hover {
            background: #f0ce82;
            transform: translateY(-3px);
        }

        .btn-outline {
            border: 1px solid #d4af65;
            color: #d4af65;
        }

        .btn-outline:hover {
            background: #d4af65;
            color: #1b1b1b;
        }

        /* ---------- Sections ---------- */

        section {
            padding: 80px 8%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 35px;
            color: #d4af65;
        }

        .section-title p {
            color: #aaaaaa;
        }

        /* ---------- About ---------- */

        .about {
            background: #252525;
        }

        .info-grid {
            max-width: 1000px;
            margin: auto;

            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .info-card {
            padding: 25px;

            background: #303030;

            border: 1px solid #444;

            border-left: 4px solid #d4af65;

            border-radius: 10px;
        }

        .info-card h3 {
            color: #d4af65;
            margin-bottom: 8px;
        }

        .info-card p {
            color: #dddddd;
        }

        /* ---------- Highlights ---------- */

        .highlights {
            background: #1f1f1f;
        }

        .highlight-grid {
            max-width: 1100px;
            margin: auto;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .highlight-card {
            background: #292929;
            padding: 30px;

            text-align: center;

            border-radius: 12px;

            border: 1px solid #3f3f3f;

            transition: 0.3s;
        }

        .highlight-card:hover {
            transform: translateY(-8px);

            border-color: #d4af65;

            box-shadow:
                0 10px 30px rgba(212, 175, 101, 0.1);
        }

        .highlight-card .icon {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .highlight-card h3 {
            color: #d4af65;
            margin-bottom: 10px;
        }

        .highlight-card p {
            color: #bbbbbb;
        }

        /* ---------- Footer ---------- */

        footer {
            text-align: center;
            padding: 30px;

            background: #151515;

            color: #888888;

            border-top: 1px solid #333;
        }

        footer span {
            color: #d4af65;
        }

        /* ---------- Mobile ---------- */

        @media (max-width: 768px) {

            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav ul {
                gap: 15px;
                font-size: 14px;
            }

            .hero {
                flex-direction: column;
                text-align: center;
                gap: 40px;
            }

            .profile-image {
                width: 220px;
                height: 220px;
            }

            .hero-text h1 {
                font-size: 40px;
            }

            .buttons {
                justify-content: center;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .highlight-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav>

        <div class="logo">
            MY PORTFOLIO
        </div>

        <ul>
            <li>
                <a href="#home">หน้าแรก</a>
            </li>

            <li>
                <a href="#about">ประวัติ</a>
            </li>

            <li>
                <a href="#highlight">จุดเด่น</a>
            </li>

            <!-- เปลี่ยนลิงก์ตรงนี้ได้ -->
            <li>
                <a href="portfolio.html">ผลงาน</a>
            </li>
        </ul>

    </nav>


    <!-- Home -->
    <section class="hero" id="home">

        <!--
            เปลี่ยน profile.jpg
            เป็นชื่อไฟล์รูปของเรา
        -->

        <img
            src="profile.jpg"
            alt="รูปโปรไฟล์"
            class="profile-image"
        >

        <div class="hero-text">

            <div class="hello">
                👋 ยินดีต้อนรับเข้าสู่ Portfolio
            </div>

            <!-- เปลี่ยนชื่อ -->
            <h1>
                สวัสดีครับ/ค่ะ<br>
                ฉันชื่อ <นางสาวปุณยนุช บุญเรือง/span>
            </h1>

            <p>
                นี่คือแฟ้มสะสมผลงานของฉัน
                เว็บไซต์นี้รวบรวมประวัติการศึกษา
                ความสนใจ ความสามารถ และผลงานต่าง ๆ
            </p>

            <div class="buttons">

                <a href="#about" class="btn btn-gold">
                    ดูประวัติ
                </a>

                <!--
                    กดแล้วไปหน้า portfolio.html
                -->

                <a href="portfolio.html" class="btn btn-outline">
                    ดูผลงาน
                </a>

            </div>

        </div>

    </section>


    <!-- About -->
    <section class="about" id="about">

        <div class="section-title">

            <h2>เกี่ยวกับฉัน</h2>

            <p>
                Personal Information
            </p>

        </div>


        <div class="info-grid">

            <!-- วันเกิด -->

            <div class="info-card">

                <h3>🎂 วันเกิด</h3>

                <p>
                    8 กรกฏาคม 2551
                </p>

            </div>


            <!-- การศึกษา -->

            <div class="info-card">

                <h3>🎓 ประวัติการศึกษา</h3>

                <p>
                    โรงเรียนบ้านบึง อุตสาหกรรมนุเคราะห์
                    <br>
                    จีน-อังกฤษ
                </p>

            </div>


            <!-- ความสนใจ -->

            <div class="info-card">

                <h3>💡 ความสนใจ</h3>

                <p>
                    การเขียนโปรแกรม,
                    เทคโนโลยี,
                    การออกแบบเว็บไซต์
                </p>

            </div>


            <!-- เป้าหมาย -->

            <div class="info-card">

                <h3>🎯 เป้าหมาย</h3>

                <p>
                    ต้องการพัฒนาทักษะด้านเทคโนโลยี
                    และสร้างผลงานที่มีประโยชน์
                </p>

            </div>

        </div>

    </section>


    <!-- Highlights -->
    <section class="highlights" id="highlight">

        <div class="section-title">

            <h2>จุดเด่นของฉัน</h2>

            <p>
                My Strengths
            </p>

        </div>


        <div class="highlight-grid">

            <div class="highlight-card">

                <div class="icon">
                    💻
                </div>

                <h3>
                    Programming
                </h3>

                <p>
                    สนใจการเขียนโปรแกรม
                    และการพัฒนาเว็บไซต์
                </p>

            </div>


            <div class="highlight-card">

                <div class="icon">
                    🎨
                </div>

                <h3>
                    Creative
                </h3>

                <p>
                    ชอบออกแบบและสร้างสรรค์
                    ไอเดียใหม่ ๆ
                </p>

            </div>


            <div class="highlight-card">

                <div class="icon">
                    🚀
                </div>

                <h3>
                    Learning
                </h3>

                <p>
                    พร้อมเรียนรู้สิ่งใหม่
                    และพัฒนาตัวเองอยู่เสมอ
                </p>

            </div>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        © 2026
        <span>ชื่อของคุณ</span>
        | My Portfolio

    </footer>

</body>
</html>

